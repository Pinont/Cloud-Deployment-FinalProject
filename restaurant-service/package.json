{
  "name": "restaurant-service",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage",
    "lint": "eslint .",
    "seed": "node scripts/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 120000,
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "dependencies": {
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1"
  }
}
